rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(restaurantId) {
      return isAuthenticated() && getUserData().restaurantId == restaurantId;
    }

    function isOwnerOf(restaurantId) {
      return isMemberOf(restaurantId) && getUserData().role == 'owner';
    }

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() <= 100 && id.size() > 0;
    }

    function isValidNewOrder() {
      let data = request.resource.data;
      return isValidId(data.restaurantId)
        && data.status is string
        && data.status in ['pending', 'preparing', 'ready', 'served', 'completed', 'cancelled']
        && data.total is number
        && data.total >= 0
        && data.items is list;
    }

    match /restaurants/{restaurantId} {
      allow get: if true;
      allow list: if false; // Users shouldn't list all restaurants
      allow create: if isAuthenticated() && isValidId(restaurantId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwnerOf(restaurantId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'createdAt']));
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwnerOf(resource.data.restaurantId));
      allow create: if isAuthenticated() && (request.auth.uid == userId || isOwnerOf(request.resource.data.restaurantId));
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isOwnerOf(resource.data.restaurantId));
    }

    match /menuCategories/{docId} {
      allow read: if true;
      allow create: if isMemberOf(request.resource.data.restaurantId);
      allow update: if isMemberOf(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if isMemberOf(resource.data.restaurantId);
    }

    match /menuItems/{docId} {
      allow read: if true;
      allow create: if isMemberOf(request.resource.data.restaurantId);
      allow update: if isMemberOf(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if isMemberOf(resource.data.restaurantId);
    }

    match /tables/{docId} {
      allow read: if true;
      allow create: if isMemberOf(request.resource.data.restaurantId);
      allow update: if isMemberOf(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if isMemberOf(resource.data.restaurantId);
    }

    match /orders/{docId} {
      // Orders are only visible to authenticated staff of the owning restaurant.
      allow read: if isMemberOf(resource.data.restaurantId);
      // Customers may submit orders, but the payload is validated and cannot be
      // used to inject arbitrary fields or forge orders for another tenant.
      allow create: if isValidNewOrder();
      // Only staff of the owning restaurant may modify/complete orders, and the
      // order cannot be reassigned to a different restaurant.
      allow update: if isMemberOf(resource.data.restaurantId)
        && request.resource.data.restaurantId == resource.data.restaurantId;
      allow delete: if isMemberOf(resource.data.restaurantId);
    }
  }
}
