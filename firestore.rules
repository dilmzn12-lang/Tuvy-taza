rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMemberOf(restaurantId) {
      return isAuthenticated() && getUserData().restaurantId == restaurantId;
    }

    function isOwnerOf(restaurantId) {
      return isMemberOf(restaurantId) && getUserData().role == 'owner';
    }

    function isValidId(id) {
      return id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() <= 100 && id.size() > 0;
    }

    match /restaurants/{restaurantId} {
      allow get: if true;
      allow list: if false; // Users shouldn't list all restaurants
      allow create: if isAuthenticated() && isValidId(restaurantId) && request.resource.data.ownerId == request.auth.uid;
      allow update: if isOwnerOf(restaurantId) && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['ownerId', 'createdAt']));
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isOwnerOf(resource.data.restaurantId));
      allow create: if isAuthenticated() && (request.auth.uid == userId || isOwnerOf(request.resource.data.restaurantId));
      allow update, delete: if isAuthenticated() && (request.auth.uid == userId || isOwnerOf(resource.data.restaurantId));
    }

    match /menuCategories/{docId} {
      allow read: if true;
      allow write: if isMemberOf(resource.data.restaurantId) || isMemberOf(request.resource.data.restaurantId);
    }

    match /menuItems/{docId} {
      allow read: if true;
      allow write: if isMemberOf(resource.data.restaurantId) || isMemberOf(request.resource.data.restaurantId);
    }

    match /tables/{docId} {
      allow read: if true;
      allow write: if isMemberOf(resource.data.restaurantId) || isMemberOf(request.resource.data.restaurantId);
    }

    match /orders/{docId} {
      allow read: if true; // In production we should lock this down, but allowing for now for customer realtime updates
      allow write: if true; // Customers can submit orders
    }
  }
}
