{
  "entities": {
    "Restaurant": {
      "title": "Restaurant",
      "description": "A restaurant tenant",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "ownerId", "createdAt"]
    },
    "User": {
      "title": "User",
      "description": "A user belonging to a restaurant",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "role": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "role", "name", "email", "createdAt"]
    },
    "MenuCategory": {
      "title": "MenuCategory",
      "description": "Category for menu items",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "name": { "type": "string" },
        "order": { "type": "number" }
      },
      "required": ["restaurantId", "name", "order"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "Item on the menu",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "categoryId": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "isAvailable": { "type": "boolean" },
        "description": { "type": "string" }
      },
      "required": ["restaurantId", "categoryId", "name", "price", "isAvailable"]
    },
    "Table": {
      "title": "Table",
      "description": "Table in the restaurant",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["restaurantId", "name", "status"]
    },
    "Order": {
      "title": "Order",
      "description": "Order for a table",
      "type": "object",
      "properties": {
        "restaurantId": { "type": "string" },
        "tableId": { "type": "string" },
        "status": { "type": "string" },
        "totalAmount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["restaurantId", "tableId", "status", "totalAmount", "createdAt"]
    }
  },
  "firestore": {
    "/restaurants/{restaurantId}": {
      "schema": { "$ref": "#/entities/Restaurant" },
      "description": "Stores restaurant details"
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "Stores user roles"
    },
    "/menuCategories/{categoryId}": {
      "schema": { "$ref": "#/entities/MenuCategory" },
      "description": "Menu categories"
    },
    "/menuItems/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Menu items"
    },
    "/tables/{tableId}": {
      "schema": { "$ref": "#/entities/Table" },
      "description": "Tables"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Orders"
    }
  }
}
