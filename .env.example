# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase web config values for local development.
# These are safe to expose in the frontend bundle and can fall back to the hardcoded defaults in src/lib/firebase.ts.
VITE_FIREBASE_API_KEY="AIzaSyBq6FjDsEUVqi3njBJAGzJD2ziI87ywmGg"
VITE_FIREBASE_AUTH_DOMAIN="gen-lang-client-0907948855.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0907948855"
VITE_FIREBASE_STORAGE_BUCKET="gen-lang-client-0907948855.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="525366296558"
VITE_FIREBASE_APP_ID="1:525366296558:web:43683c9884f57547f418ff"
